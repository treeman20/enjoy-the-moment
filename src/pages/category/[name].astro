---
import Base from '../../layouts/Base.astro';
import Tabs from '../../components/Tabs.astro';
import StoryList from '../../components/StoryList.astro';
import site from '../../data/site.json';
import cats from '../../data/categories.json';
import { getWorks } from '../../lib/works';

export async function getStaticPaths() {
  const works = await getWorks();
  const names = new Set<string>([...site.categories, ...works.map((w) => w.data.category).filter(Boolean) as string[]]);
  return [...names].map((name) => ({
    params: { name },
    props: { name, works: works.filter((w) => w.data.category === name) },
  }));
}
const { name, works } = Astro.props;
const note = cats.notes.find((c) => c.name === name)?.note;
---
<Base title={name} description={note ? `${name}｜${note}` : `${site.title}「${name}」分類下的攝影與AI創作系列，共 ${works.length} 篇。`}>
  <section class="pub-head container">
    <h1>{name}</h1>
    {note && <p class="cat-note">{note}</p>}
    <p>{works.length} 篇</p>
  </section>
  <Tabs current={name} />
  <div class="container">
    <StoryList works={works} showCategory={false} />
  </div>
</Base>
