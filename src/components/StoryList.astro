---
import site from '../data/site.json';
import { coverOf, formatDate, isoDate, plainExcerpt, type Work } from '../lib/works';
interface Props { works: Work[]; featureFirst?: boolean; showCategory?: boolean }
const { works, featureFirst = true, showCategory = true } = Astro.props;
const [first, ...rest] = works;
const list = featureFirst ? rest : works;
---
<div class="list">
  {works.length === 0 && <p class="empty">這裡還沒有作品。</p>}

  {featureFirst && first && (
    <a class="lead" href={`/works/${first.id}/`}>
      <div class="thumb">
        {coverOf(first) && <img src={coverOf(first)} alt={first.data.title} loading="eager" />}
      </div>
      <div class="body">
        {showCategory && first.data.category && <div class="cat">{first.data.category}</div>}
        <h2>{first.data.title}</h2>
        <p>{plainExcerpt(first, 140)}</p>
        <div class="meta">
          <span>{site.author}</span>
          <span>·</span>
          <time datetime={isoDate(first.data.date)}>{formatDate(first.data.date)}</time>
          {first.data.images?.length ? <><span>·</span><span>{first.data.images.length} 張影像</span></> : null}
        </div>
      </div>
    </a>
  )}

  {list.length > 0 && (
    <div class="cards">
      {list.map((w) => (
        <a class="card" href={`/works/${w.id}/`}>
          <div class="thumb">
            {coverOf(w) && <img src={coverOf(w)} alt={w.data.title} loading="lazy" decoding="async" />}
          </div>
          {showCategory && w.data.category && <div class="cat">{w.data.category}</div>}
          <h3>{w.data.title}</h3>
          <p>{plainExcerpt(w)}</p>
          <div class="meta">
            <span>{site.author}</span>
            <span>·</span>
            <time datetime={isoDate(w.data.date)}>{formatDate(w.data.date)}</time>
            {w.data.images?.length ? <><span>·</span><span>{w.data.images.length} 張</span></> : null}
          </div>
        </a>
      ))}
    </div>
  )}
</div>
